# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
PORT=3175
API_PREFIX=api
FRONTEND_URL=http://localhost:4200

# ============================================
# DATABASE (PostgreSQL)
# ============================================
# For Neon or other hosted solutions — use DATABASE_URL instead:
# DATABASE_URL=postgres://user:password@host:port/database?sslmode=require
DATABASE_SSL=false
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=backend_db

# ============================================
# STORAGE (MinIO / Cloudflare R2)
# ============================================
# STORAGE_PROVIDER: 'minio' or 'cloudflare'
STORAGE_PROVIDER=minio
STORAGE_BUCKET_NAME=backend
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin

# MinIO local      → http://localhost:9000
# Cloudflare R2    → https://<account_id>.r2.cloudflarestorage.com
STORAGE_ENDPOINT=http://localhost:9000

# MinIO local      → http://localhost:9000/backend
# Cloudflare R2    → https://pub-<id>.r2.dev
STORAGE_PUBLIC_URL=http://localhost:9000/backend

# Required only for Cloudflare R2
STORAGE_ACCOUNT_ID=

# ============================================
# JWT (Authentication)
# ============================================
JWT_SECRET=super-secret-key
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super-refresh-secret-key
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# CORS
# ============================================
CORS_ORIGINS=http://localhost:4200

# ============================================
# SMTP (Email)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_SENDER_EMAIL=noreply@yourdomain.com
SMTP_SENDER_NAME=Backend API

# ============================================
# pgAdmin (Docker only)
# ============================================
PG_ADMIN_USER=admin@admin.com
PG_ADMIN_PASSWORD=admin
PG_ADMIN_PORT=5050

# =========================
# MONITORING LOCAL
# =========================
PROMETHEUS_PORT=9090
LOKI_PORT=3100
GRAFANA_PORT=3001
NODE_EXPORTER_PORT=9100

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

GRAFANA_LOKI_HOST=http://localhost:3100
GRAFANA_LOKI_USERNAME=
GRAFANA_LOKI_PASSWORD=